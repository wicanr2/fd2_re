{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fd2-remake.invalid/schema/fd2-full-locale-content-v1.json",
  "title": "FD2 全量語系內容目錄",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "locale", "source_locale", "entry_count", "inventory_sha256", "glossary_sha256", "pivot_content_sha256", "translation_engine", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "fd2_full_locale_content"},
    "locale": {"enum": ["zh-Hant", "zh-Hans", "ja", "en"]},
    "source_locale": {"const": "zh-Hant"},
    "entry_count": {"type": "integer", "minimum": 1},
    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "glossary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pivot_content_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "translation_engine": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["string_id", "id_status", "role", "text", "variables", "status", "source"],
        "properties": {
          "string_id": {"type": "string", "minLength": 1},
          "id_status": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "variables": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["source", "machine_draft", "reviewed", "blocked"]},
          "source": {"type": "object"}
        }
      }
    }
  }
}
