{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wicanr2/fd2_re/docs/data/schema/fd2-string-inventory.schema.json",
  "title": "FD2 diagnostic string inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "locale", "status", "generated_by", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "fd2_string_inventory"},
    "locale": {"const": "zh-Hant"},
    "status": {"const": "diagnostic"},
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version"],
      "properties": {
        "tool": {"const": "fd2-string-inventory"},
        "version": {"const": "1"}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["string_id", "id_status", "role", "confidence", "text", "variables", "source"],
        "properties": {
          "string_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$"},
          "id_status": {"enum": ["existing_stable_id", "provisional_legacy_path", "provisional_source_location"]},
          "role": {"type": "string", "minLength": 1},
          "confidence": {"enum": ["field_rule", "direct_ui_context", "function_context", "non_ascii_production_literal"]},
          "text": {"type": "string", "minLength": 1},
          "variables": {"type": "array", "items": {"type": "string"}},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file"],
            "properties": {
              "file": {"type": "string", "minLength": 1},
              "json_pointer": {"type": "string"},
              "function": {"type": "string", "minLength": 1},
              "line": {"type": "integer", "minimum": 1},
              "column": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    }
  }
}
