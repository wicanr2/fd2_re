    "prior_receipt": "docs/data/fd2-modern-hd-dialogue-20261018.json",
    "negative_run": "work/promo-cadence-20261018/hd-dialogue/normal-r3"
  },
  "findings": [
    "saveGameToSlot保存handlerChapter，omitempty省略首章零值；loadJSONGameFromSlot解碼為相同零值並正常恢復節點。",
    "nativeLoadSlotMetadata是原生文字框的metadata投影；JSON章零不能由此投影確認。原生槽restore plan另有raw章號加一的顯示映射，不能反推為JSON章號格式遷移。",
    "confirmTitleLoadSlot原JSON分支呼叫void包裝，忽略實際還原是否成功，會錯誤離開選槽。"
  ],
  "contract": {
    "input": "有界槽0..3、既有JSON節點存檔或明示FD2_NATIVE_SAVE",
    "json_confirmation": "標題JSON確認直接呼叫與F9共用的loadJSONGameFromSlot；成功才清titlePhase，失敗留在loadslots。",
    "chapter": "JSON仍保存原handlerChapter，允許0..255；缺章號維持Go零值，不猜填、不加一、不遷移schema。超界章號由共用JSON讀取者在發布前拒收。",
    "presentation": "保留既有nativeLoadSlotMetadata與原生Draw；無法投影的首章JSON仍使用目前已存在的在地化四槽畫面，已儲存／空槽標示不變。",
    "native_sav": "檢查碼、metadata、typed restore與失敗守衛保持。",
    "failure": "非法槽、JSON解碼、未知節點、隊伍、系統選項等失敗不離開標題選槽。既有enterNode載入後失敗的整體原子性不在本輪擴張。",
    "format": "不改saveData欄位與writer，舊檔不重寫。"
  },
  "acceptance": [
    "回歸先在原程式失敗：首章零章號正常writer存檔可標題確認，拒收讀取結果不清titlePhase。",
    "JSON章號上下界、空／缺槽、未知節點、隊伍／選項拒收與原生SAV檢查碼回歸通過。",
    "同份正常F5原樣存檔在忠實與HD兩個新程序由普通標題LOAD讀取，與F9節點、隊伍及章號一致，保存SHA不變。",
    "正常首章F5重新保存後可由新的標題LOAD冷讀，記錄writer產物SHA。"
  ],
  "limits": [
    "只證明重製端JSON玩家路徑，不宣稱新的原版parity。",
    "不新增HD素材、版面或跨平台實機驗收；不錄影。"
  ],
