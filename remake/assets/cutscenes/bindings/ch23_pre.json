          "line": 6,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_024",
            "string_index": 1,
            "utterance": 1,
            "control": "FFED",
            "operand": 17,
            "pages": [
              [
                "『笨！那是魔法驅動的飛行裝",
                "　置，那些人是乘坐在上面的",
                "　乘客！』"
              ]
            ]
          }
        },
        {
          "line": 7,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_024",
            "string_index": 1,
            "utterance": 2,
            "control": "FFED",
            "operand": 18,
            "pages": [
              [
                "『他們想幹什麼？想突破這裡",
                "　的空域前往火焰之谷嗎？』"
              ]
            ]
          }
        },
        {
          "line": 8,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_024",
            "string_index": 1,
            "utterance": 3,
            "control": "FFED",
            "operand": 19,
            "pages": [
              [
                "『陛下吩咐過我們，絕不可讓",
                "　任何人從空中或地下經過此",
                "　地的！』"
              ]
            ]
          }
        },
        {
          "line": 9,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_024",
            "string_index": 1,
            "utterance": 4,
            "control": "FFED",
            "operand": 16,
            "pages": [
              [
                "『所以現在我們要宰了那些傢",
                "　伙！上吧！』"
              ]
            ]
          }
        },
        {
          "line": 10,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_024",
            "string_index": 1,
            "utterance": 5,
            "control": "FFEE",
            "operand": 16,
            "pages": [
              [
                "『哇！對方來意不善呢！好像",
                "　想要動手了！』"
              ]
            ]
          }
        },
        {
          "line": 11,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_024",
            "string_index": 1,
            "utterance": 6,
            "control": "FFEE",
            "operand": 4,
            "pages": [
              [
                "『要在這種地方打嗎？好像對",
                "　我們很不利吧！』"
              ]
            ]
          }
        },
        {
          "line": 12,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_024",
            "string_index": 1,
            "utterance": 7,
            "control": "FFEE",
            "operand": 20,
            "pages": [
              [
                "『我們的伙伴中還有幾個會飛",
                "　的，勉強可以牽制敵方的攻",
                "　勢，你們只要在地上確貫消"
              ],
              [
                "　滅敵人就可以了！』"
              ]
            ]
          }
        },
        {
          "line": 13,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_024",
            "string_index": 1,
            "utterance": 8,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『對方不過是會飛而已，有什",
                "　麼好怕的！我們先打了再說",
                "　！』"
              ]
            ]
          }
        }
      ]
