            "utterance": 0,
            "control": "FFED",
            "operand": 16,
            "pages": [
              [
                "『那．那是什麼？飛行的大岩",
                "　石，上面有人？』"
              ]
            ],
            "glyph_ids": [
              [
                [
                  557,
