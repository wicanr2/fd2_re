            "string_index": 4,
            "utterance": 9,
            "control": "FFEE",
            "operand": 13,
            "pages": [
              [
                "『我和他算是舊識了，這回就",
                "　是他要我到王城和他碰面，",
                "　才會遇上這些事情的。』"
              ]
