  "dialogue_overrides": {
    "0x23525#3": {
      "script": "ch08.json",
      "scene_index": 3,
      "lines": [
        {
          "line": 0,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_008",
            "string_index": 3,
            "utterance": 0,
            "control": "FFEE",
            "operand": 8,
            "pages": [
              [
                "『唉！事情為什麼會變成這樣",
                "　．．我得去見父王一面，",
                "　把事情弄個清楚才行。』"
              ]
            ]
          }
        },
        {
          "line": 1,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_008",
            "string_index": 3,
            "utterance": 1,
            "control": "FFEF",
            "operand": 5,
            "pages": [
              [
                "『公主殿下，現在宮中情勢混",
                "　亂，請容屬下隨行，以保護",
                "　殿下的安全。』"
              ]
            ]
          }
        },
        {
          "line": 2,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_008",
            "string_index": 3,
            "utterance": 2,
            "control": "FFEE",
            "operand": 8,
            "pages": [
              [
                "『剛才妳說妳是史卡迪家的人",
                "　．．可是指騎士世家的史卡",
                "　迪家族？』"
              ]
            ]
          }
        },
        {
          "line": 3,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_008",
            "string_index": 3,
            "utterance": 3,
            "control": "FFEF",
            "operand": 5,
            "pages": [
              [
                "『是的！我史卡迪家的族人世",
                "　代都擔負保護王族的使命，",
                "　如今雖然我家族只剩下我一"
              ],
              [
                "　個人，屬下仍會盡忠職守，",
                "　誓以性命保護殿下的安全。",
                "　』"
              ]
            ]
          }
        },
        {
          "line": 4,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_008",
            "string_index": 3,
            "utterance": 4,
            "control": "FFEE",
            "operand": 8,
            "pages": [
              [
                "『我明白了，妳就跟我來吧．",
                "　．索爾，亞雷斯，以後我還",
                "　要借重你們的力量，你們也"
              ],
              [
                "　和我一起進城吧！』"
              ]
            ]
          }
        }
      ]
    },
    "0x23560#4": {
      "script": "ch08.json",
      "scene_index": 3,
      "lines": [
        {
          "line": 5,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_008",
            "string_index": 4,
            "utterance": 0,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『希莉亞．．是王國公主？",
                "　那悠妮的身份又是怎麼",
                "　一回事？』"
              ]
            ]
          }
        },
        {
          "line": 6,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_008",
            "string_index": 4,
            "utterance": 1,
            "control": "FFEE",
            "operand": 4,
            "pages": [
              [
                "『很簡單，是我們搞錯啦。",
                "　現在該怎麼辦？』"
              ]
            ]
          }
        },
        {
          "line": 7,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_008",
            "string_index": 4,
            "utterance": 2,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『事到如今，也只有跟著希莉",
                "　亞進去看看了。走吧！』"
              ]
            ]
          }
        }
      ]
    }
  }
