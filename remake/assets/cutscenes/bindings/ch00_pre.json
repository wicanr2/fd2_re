  "dialogue_overrides": {
    "0x32382#0": {
      "script": "ch00_palace.json",
      "scene_index": 0,
      "lines": [
        {
          "line": 0,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 0,
            "utterance": 0,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『兒臣索爾，晉見父王陛下。",
                "　』"
              ]
            ]
          }
        },
        {
          "line": 1,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 0,
            "utterance": 1,
            "control": "FFED",
            "operand": 0,
            "pages": [
              [
                "『你來啦！起來起來，這裡沒",
                "　有別人，不用多禮。』"
              ]
            ]
          }
        },
        {
          "line": 2,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 0,
            "utterance": 2,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『多謝父王。』"
              ]
            ]
          }
        },
        {
          "line": 3,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 0,
            "utterance": 3,
            "control": "FFED",
            "operand": 0,
            "pages": [
              [
                "『到這裡來，讓父王好好看看",
                "　你。這一陣子國務繁忙，我",
                "　們父子兩個也很久沒聚聚了"
              ],
              [
                "　。』"
              ]
            ]
          }
        },
        {
          "line": 4,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 0,
            "utterance": 4,
            "control": "FFED",
            "operand": 1,
            "pages": [
              [
                "『是啊！我們一家人，難得這",
                "　樣在一起。』"
              ]
            ]
          }
        },
        {
          "line": 5,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 0,
            "utterance": 5,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『是。』"
              ]
            ]
          }
        }
      ]
    },
    "0x323cb#1": {
      "script": "ch00_palace.json",
      "scene_index": 0,
      "lines": [
        {
          "line": 6,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 1,
            "utterance": 0,
            "control": "FFED",
            "operand": 0,
            "pages": [
              [
                "『索爾，時間過得真快，你已",
                "　經長得這麼高了。大臣和將",
                "　領們對你的武藝和能力也讚"
              ],
              [
                "　譽有加，我想，也該是決定",
                "　王位繼承人的時候了。』"
              ]
            ]
          }
        },
        {
          "line": 7,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 1,
            "utterance": 1,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『是的，父王，想必是由皇弟",
                "　迪恩接任王位，兒臣不勝欣",
                "　喜。』"
              ]
            ]
          }
        },
        {
          "line": 8,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 1,
            "utterance": 2,
            "control": "FFED",
            "operand": 0,
            "pages": [
              [
                "『錯了，索爾，朕希望能由你",
                "　來接任羅特帝亞的王位。』"
              ]
            ]
          }
        },
        {
          "line": 9,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 1,
            "utterance": 3,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『啊？兒．兒臣我來接任王位",
                "　？』"
              ]
            ]
          }
        },
        {
          "line": 10,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 1,
            "utterance": 4,
            "control": "FFED",
            "operand": 0,
            "pages": [
              [
                "『是的，索爾。你對朕的決定",
                "　有什麼疑問嗎？』"
              ]
            ]
          }
        },
        {
          "line": 11,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 1,
            "utterance": 5,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『兒臣不敢。但．．．但是，",
                "　父王，兒臣並未繼承羅特帝",
                "　亞王家的血脈，照理來說，"
              ],
              [
                "　兒臣以為應該由皇弟迪恩",
                "　來繼承王位．．』"
              ]
            ]
          }
        },
        {
          "line": 12,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 1,
            "utterance": 6,
            "control": "FFED",
            "operand": 0,
            "pages": [
              [
                "『索爾，這是一個屬於強者的",
                "　時代。只有強者才能牢握軍",
                "　隊、統治國家，維持世界的"
              ],
              [
                "　和平和人民的福祉。羅特帝",
                "　亞需要一個強有力的統治者",
                "　我相信你能接替我繼承王位"
              ],
              [
                "　一一而且也只有你才能繼承",
                "　王位。』"
              ]
            ]
          }
        },
        {
          "line": 13,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 1,
            "utterance": 7,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『可是，皇弟他．．』"
              ]
            ]
          }
        },
        {
          "line": 14,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 1,
            "utterance": 8,
            "control": "FFED",
            "operand": 0,
            "pages": [
              [
                "『迪恩他和你不一樣。迪恩是",
                "　個聰明的孩子，可以成為賢",
                "　明的君主，但是他長得太文"
              ],
              [
                "　弱了，無法穿著重甲、統率",
                "　大軍在戰場上奔馳。我還記",
                "　得當我還是個孩子時所發生"
              ],
              [
                "　的事情，所以．為了羅特帝",
                "　亞王族，為了羅特帝亞王國",
                "　的人民，我希望你能成為王"
              ],
              [
                "　位繼承人。』"
              ]
            ]
          }
        },
        {
          "line": 15,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 1,
            "utterance": 9,
            "control": "FFED",
            "operand": 1,
            "pages": [
              [
                "『是的。索爾，這些年來，我",
                "　們把你當成自己親生的孩子",
                "　撫義長大，這件事也是經過"
              ],
              [
                "　慎重考慮之後才決定的，希",
                "　望你能夠答應。』"
              ]
            ]
          }
        },
        {
          "line": 16,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 1,
            "utterance": 10,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『兒臣．兒臣．』"
              ]
            ]
          }
        },
        {
          "line": 17,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 1,
            "utterance": 11,
            "control": "FFED",
            "operand": 0,
            "pages": [
              [
                "『我就知道你會一時無法接受",
                "　這樣吧，三天之後，你再給",
                "　我考慮的結果，當然了，我"
              ],
              [
                "　希望能夠聽到肯定的答覆。",
                "　你先回去休息吧。』"
              ]
            ]
          }
        },
        {
          "line": 18,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 1,
            "utterance": 12,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『．是的。兒臣告退。』"
              ]
            ]
          }
        }
      ]
    },
    "0x3244d#2": {
      "script": "ch00_palace.json",
      "scene_index": 1,
      "lines": [
        {
          "line": 0,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 2,
            "utterance": 0,
            "control": "FFED",
            "operand": 4,
            "pages": [
              [
                "『哈！找你找了半天，居然是",
                "　躲在這裡打瞎睡，真是一點",
                "　都不像你的作風。』"
              ]
            ]
          }
        },
        {
          "line": 1,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 2,
            "utterance": 1,
            "control": "FFEC",
            "operand": 3,
            "pages": [
              [
                "『．．』"
              ]
            ]
          }
        },
        {
          "line": 2,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 2,
            "utterance": 2,
            "control": "FFED",
            "operand": 4,
            "pages": [
              [
                "『怎麼啦？你今天好像有點不",
                "　太對勁？』"
              ]
            ]
          }
        },
        {
          "line": 3,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 2,
            "utterance": 3,
            "control": "FFEC",
            "operand": 3,
            "pages": [
              [
                "『．．唉！』"
              ]
            ]
          }
        },
        {
          "line": 4,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 2,
            "utterance": 4,
            "control": "FFED",
            "operand": 4,
            "pages": [
              [
                "『嘿！待會兒是不是要打雷了",
                "　你居然在嘆氣！我看我們得",
                "　好好談一談了！』"
              ]
            ]
          }
        }
      ]
    },
    "0x32488#3": {
      "script": "ch00_palace.json",
      "scene_index": 1,
      "lines": [
        {
          "line": 5,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 3,
            "utterance": 0,
            "control": "FFED",
            "operand": 4,
            "pages": [
              [
                "『索爾，到底是發生什麼事了",
                "　？』"
              ]
            ]
          }
        },
        {
          "line": 6,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 3,
            "utterance": 1,
            "control": "FFEC",
            "operand": 3,
            "pages": [
              [
                "『．其貫也沒什麼啦。』"
              ]
            ]
          }
        },
        {
          "line": 7,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 3,
            "utterance": 2,
            "control": "FFED",
            "operand": 4,
            "pages": [
              [
                "『少裝啦！這世界上能讓你嘆",
                "　氣的事絕對不會超過十件。",
                "　說來聽聽吧！』"
              ]
            ]
          }
        },
        {
          "line": 8,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 3,
            "utterance": 3,
            "control": "FFED",
            "operand": 3,
            "pages": [
              [
                "『．父王要我繼承王位。』"
              ]
            ]
          }
        }
      ]
    },
    "0x324c3#4": {
      "script": "ch00_palace.json",
      "scene_index": 1,
      "lines": [
        {
          "line": 9,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 4,
            "utterance": 0,
            "control": "FFED",
            "operand": 4,
            "pages": [
              [
                "『嗄？』"
              ]
            ]
          }
        }
      ]
    },
    "0x324fe#5": {
      "script": "ch00_palace.json",
      "scene_index": 1,
      "lines": [
        {
          "line": 10,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 5,
            "utterance": 0,
            "control": "FFEC",
            "operand": 3,
            "pages": [
              [
                "『沒聽清楚嗎？父王要我繼承",
                "　王位。』"
              ]
            ]
          }
        },
        {
          "line": 11,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 5,
            "utterance": 1,
            "control": "FFED",
            "operand": 4,
            "pages": [
              [
                "『嗄？．這．這有什麼好嘆氣",
                "　的？羅特帝亞的准王位繼承",
                "　人．．這要好好慶祝一下才"
              ],
              [
                "　是啊！』"
              ]
            ]
          }
        },
        {
          "line": 12,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 5,
            "utterance": 2,
            "control": "FFEC",
            "operand": 3,
            "pages": [
              [
                "『笨蛋！枉費我們從小一起長",
                "　大，你竟然一點都不瞭解我",
                "　！』"
              ]
            ]
          }
        },
        {
          "line": 13,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 5,
            "utterance": 3,
            "control": "FFED",
            "operand": 4,
            "pages": [
              [
                "『啊？這怎麼說呢？』"
              ]
            ]
          }
        },
        {
          "line": 14,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 5,
            "utterance": 4,
            "control": "FFEC",
            "operand": 3,
            "pages": [
              [
                "『我怎麼會喜歡國王一職！整",
                "　天待在王城裏哪裡也不能去",
                "　還得管理繁瑣的政務、應付"
              ],
              [
                "　囉唆的大臣和官員．．那有",
                "　什麼樂趣！』"
              ]
            ]
          }
        },
        {
          "line": 15,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 5,
            "utterance": 5,
            "control": "FFED",
            "operand": 4,
            "pages": [
              [
                "『以你的個性來說．這樣講也",
                "　沒錯。』"
              ]
            ]
          }
        },
        {
          "line": 16,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 5,
            "utterance": 6,
            "control": "FFEC",
            "operand": 3,
            "pages": [
              [
                "『我從小想做的事，就是到外",
                "　地去做幾次轟轟烈烈的冒險",
                "　絕對不是枯坐在王位上終老"
              ],
              [
                "　一生！我只是父王的義子，",
                "　和羅特帝亞王家沒有血緣關",
                "　係，所以我一直以為會由皇"
              ],
              [
                "　弟迪恩繼承王位，我就可以",
                "　落得輕鬆，那知．唉！』"
              ]
            ]
          }
        },
        {
          "line": 17,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 5,
            "utterance": 7,
            "control": "FFED",
            "operand": 4,
            "pages": [
              [
                "『這就沒辦法啦。你已經被迫",
                "　答應了嗎？』"
              ]
            ]
          }
        },
        {
          "line": 18,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 5,
            "utterance": 8,
            "control": "FFEC",
            "operand": 3,
            "pages": [
              [
                "『父王要我三天後給他答覆，",
                "　但是我能說不嗎？這和答應",
                "　了有什麼兩樣！』"
              ]
            ]
          }
        },
        {
          "line": 19,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 5,
            "utterance": 9,
            "control": "FFED",
            "operand": 4,
            "pages": [
              [
                "『說的也是．只可惜這件事我",
                "　幫不上什麼忙。』"
              ]
            ]
          }
        },
        {
          "line": 20,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 5,
            "utterance": 10,
            "control": "FFEC",
            "operand": 3,
            "pages": [
              [
                "『唉！如果你想幫忙的話，現",
                "　在就陪我到後山去練劍，痛",
                "　快的打上一場之後，也許我"
              ],
              [
                "　會覺得好過一點。』"
              ]
            ]
          }
        },
        {
          "line": 21,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_033",
            "string_index": 5,
            "utterance": 11,
            "control": "FFED",
            "operand": 4,
            "pages": [
              [
                "『這是小事一樁！我們現在就",
                "　走吧！』"
              ]
            ]
          }
        }
      ]
    },
    "0x32586#0": {
      "script": "ch00_meadow.json",
      "scene_index": 0,
      "lines": [
        {
          "line": 0,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 0,
            "utterance": 0,
            "control": "FFEC",
            "operand": 0,
            "pages": [
              [
                "『亞雷斯，趕快再來比一場！",
                "　昨天輸給你，我越想越不甘",
                "　心！』"
              ]
            ]
          }
        },
        {
          "line": 1,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 0,
            "utterance": 1,
            "control": "FFED",
            "operand": 1,
            "pages": [
              [
                "『贏了就是贏了，何況你",
                "　已經打贏我十幾場，讓我一",
                "　場有什麼關係！』"
              ]
            ]
          }
        },
        {
          "line": 2,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 0,
            "utterance": 2,
            "control": "FFEC",
            "operand": 0,
            "pages": [
              [
                "『這可不一樣！我老爸說過，",
                "　劍技要不斷磨練才會進步．",
                "　．』"
              ]
            ]
          }
        },
        {
          "line": 3,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 0,
            "utterance": 3,
            "control": "FFED",
            "operand": 1,
            "pages": [
              [
                "『拜託，今天休息吧！風和日",
                "　麗的日子，躺在草地上曬曬",
                "　太陽，不是也很慷意？』"
              ]
            ]
          }
        },
        {
          "line": 4,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 0,
            "utterance": 4,
            "control": "FFEC",
            "operand": 0,
            "pages": [
              [
                "『好吧，既然如此，我回去找",
                "　侍衛們練習也可以！』"
              ]
            ]
          }
        }
      ]
    },
    "0x325c1#1": {
      "script": "ch00_meadow.json",
      "scene_index": 1,
      "lines": [
        {
          "line": 0,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 1,
            "utterance": 0,
            "control": "FFED",
            "operand": 1,
            "pages": [
              [
                "『咦，那是什麼東西？』"
              ]
            ]
          }
        }
      ]
    },
    "0x325fc#2": {
      "script": "ch00_meadow.json",
      "scene_index": 1,
      "lines": [
        {
          "line": 1,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 2,
            "utterance": 0,
            "control": "FFEC",
            "operand": 0,
            "pages": [
              [
                "『怎麼了？』"
              ]
            ]
          }
        }
      ]
    },
    "0x32643#3": {
      "script": "ch00_meadow.json",
      "scene_index": 1,
      "lines": [
        {
          "line": 2,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 3,
            "utterance": 0,
            "control": "FFEC",
            "operand": 0,
            "pages": [
              [
                "『好像是人昏倒在地呢！』"
              ]
            ]
          }
        },
        {
          "line": 3,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 3,
            "utterance": 1,
            "control": "FFEC",
            "operand": 1,
            "pages": [
              [
                "『是啊，旁邊那個大傢伙又是",
                "　什麼？』"
              ]
            ]
          }
        }
      ]
    },
    "0x3267e#4": {
      "script": "ch00_meadow.json",
      "scene_index": 1,
      "lines": [
        {
          "line": 4,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 4,
            "utterance": 0,
            "control": "FFED",
            "operand": 3,
            "pages": [
              [
                "『不要再接近！否則我將照規",
                "　定採取防衛行動！』"
              ]
            ]
          }
        },
        {
          "line": 5,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 4,
            "utterance": 1,
            "control": "FFEC",
            "operand": 1,
            "pages": [
              [
                "『搞什麼嘛！』"
              ]
            ]
          }
        }
      ]
    },
    "0x326c3#5": {
      "script": "ch00_meadow.json",
      "scene_index": 1,
      "lines": [
        {
          "line": 6,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 5,
            "utterance": 0,
            "control": "FFED",
            "operand": 4,
            "pages": [
              [
                "『嗯，好痛．．』"
              ]
            ]
          }
        },
        {
          "line": 7,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 5,
            "utterance": 1,
            "control": "FFEC",
            "operand": 1,
            "pages": [
              [
                "『是女孩子呢！』"
              ]
            ]
          }
        },
        {
          "line": 8,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 5,
            "utterance": 2,
            "control": "FFEC",
            "operand": 0,
            "pages": [
              [
                "『我去看看！』"
              ]
            ]
          }
        }
      ]
    },
    "0x326fe#6": {
      "script": "ch00_meadow.json",
      "scene_index": 1,
      "lines": [
        {
          "line": 9,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 6,
            "utterance": 0,
            "control": "FFEC",
            "operand": 0,
            "pages": [
              [
                "『小．小姐，你沒事吧！』"
              ]
            ]
          }
        },
        {
          "line": 10,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 6,
            "utterance": 1,
            "control": "FFED",
            "operand": 4,
            "pages": [
              [
                "『你．你是誰？",
                "　這裡是哪裡？』"
              ]
            ]
          }
        },
        {
          "line": 11,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 6,
            "utterance": 2,
            "control": "FFEC",
            "operand": 0,
            "pages": [
              [
                "『這裡是羅特帝亞，我叫索爾",
                "　請問小姐你的芳名？』"
              ]
            ]
          }
        },
        {
          "line": 12,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 6,
            "utterance": 3,
            "control": "FFED",
            "operand": 4,
            "pages": [
              [
                "『我叫．我叫．悠妮吧。",
                "　我怎麼會來到這裡的？』"
              ]
            ]
          }
        },
        {
          "line": 13,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 6,
            "utterance": 4,
            "control": "FFEC",
            "operand": 0,
            "pages": [
              [
                "『悠妮？好名字。悠妮小姐，",
                "　妳怎麼會記不得怎麼來到這",
                "　裡的？』"
              ]
            ]
          }
        },
        {
          "line": 14,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 6,
            "utterance": 5,
            "control": "FFED",
            "operand": 4,
            "pages": [
              [
                "『．．真的想不起來了，只記",
                "　得．只記得我好像是從很遠",
                "　很遠的地方來的。蓋亞？』"
              ]
            ]
          }
        }
      ]
    },
    "0x32739#7": {
      "script": "ch00_meadow.json",
      "scene_index": 1,
      "lines": [
        {
          "line": 15,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 7,
            "utterance": 0,
            "control": "FFED",
            "operand": 3,
            "pages": [
              [
                "『是的，主人。有何吩咐？』"
              ]
            ]
          }
        },
        {
          "line": 16,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 7,
            "utterance": 1,
            "control": "FFED",
            "operand": 4,
            "pages": [
              [
                "『我們．是從哪裡來的？』"
              ]
            ]
          }
        }
      ]
    },
    "0x32774#8": {
      "script": "ch00_meadow.json",
      "scene_index": 1,
      "lines": [
        {
          "line": 17,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 8,
            "utterance": 0,
            "control": "FFED",
            "operand": 3,
            "pages": [
              [
                "『據我的慣性導航系統顯示，",
                "　是在那個方位。』"
              ]
            ]
          }
        },
        {
          "line": 18,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 8,
            "utterance": 1,
            "control": "FFEC",
            "operand": 1,
            "pages": [
              [
                "『啊！我知道了，你們是從馬",
                "　拉大陸來的，我聽老爸說過",
                "　，那的確是個很遙遠的地方",
                "　。』"
              ]
            ]
          }
        },
        {
          "line": 19,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 8,
            "utterance": 2,
            "control": "FFEC",
            "operand": 0,
            "pages": [
              [
                "『悠妮小姐，妳是從那個馬．",
                "　馬拉大陸來的嗎？』"
              ]
            ]
          }
        },
        {
          "line": 20,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 8,
            "utterance": 3,
            "control": "FFED",
            "operand": 4,
            "pages": [
              [
                "『我記不得了，只記得．好可",
                "　怕的惡夢．好可怕．不！不",
                "　要！』"
              ]
            ]
          }
        },
        {
          "line": 21,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 8,
            "utterance": 4,
            "control": "FFEC",
            "operand": 0,
            "pages": [
              [
                "『悠．悠妮小姐！』"
              ]
            ]
          }
        },
        {
          "line": 22,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 8,
            "utterance": 5,
            "control": "FFED",
            "operand": 4,
            "pages": [
              [
                "『我好怕．帶我回家．帶我回",
                "　家，好嗎？求求你．．』"
              ]
            ]
          }
        },
        {
          "line": 23,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 8,
            "utterance": 6,
            "control": "FFEC",
            "operand": 0,
            "pages": [
              [
                "『．好！好！別怕，有我在．",
                "　放心，我一定帶妳回家！』"
              ]
            ]
          }
        },
        {
          "line": 24,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 8,
            "utterance": 7,
            "control": "FFEC",
            "operand": 1,
            "pages": [
              [
                "『哎喲喂！這小子該不會想要",
                "　．．』"
              ]
            ]
          }
        }
      ]
    },
    "0x327af#9": {
      "script": "ch00_meadow.json",
      "scene_index": 2,
      "lines": [
        {
          "line": 0,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 9,
            "utterance": 0,
            "control": "FFEC",
            "operand": 1,
            "pages": [
              [
                "『喂！你真的要去？你瘋了！",
                "　聽說那裡是與羅特帝亞完全",
                "　不一樣的地方，為了一個女"
              ],
              [
                "　孩子去冒這種險，未免．』"
              ]
            ]
          }
        },
        {
          "line": 1,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 9,
            "utterance": 1,
            "control": "FFEC",
            "operand": 0,
            "pages": [
              [
                "『我一定要去！亞雷斯，",
                "　你知不知道怎麼去？』"
              ]
            ]
          }
        },
        {
          "line": 2,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 9,
            "utterance": 2,
            "control": "FFED",
            "operand": 1,
            "pages": [
              [
                "『這？好．好吧，我回去問問",
                "　老爹，我想他應該會知道．",
                "　．』"
              ]
            ]
          }
        },
        {
          "line": 3,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 9,
            "utterance": 3,
            "control": "FFEC",
            "operand": 0,
            "pages": [
              [
                "『好極了，我們整理一些輕便",
                "　行李，我再向父王棠告一下",
                "　，就可以出發了。』"
              ]
            ]
          }
        },
        {
          "line": 4,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 9,
            "utterance": 4,
            "control": "FFEC",
            "operand": 1,
            "pages": [
              [
                "『我也去好了！誰叫我們是",
                "　從小打架打到大的朋友？",
                "　總不能就這樣讓你一個人到"
              ],
              [
                "　馬拉大陸去！』"
              ]
            ]
          }
        },
        {
          "line": 5,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 9,
            "utterance": 5,
            "control": "FFEC",
            "operand": 0,
            "pages": [
              [
                "『亞雷斯，謝謝你！』"
              ]
            ]
          }
        },
        {
          "line": 6,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_032",
            "string_index": 9,
            "utterance": 6,
            "control": "FFEC",
            "operand": 1,
            "pages": [
              [
                "『不用謝了，你先帶悠妮小姐",
                "　回去休義吧！陛下那邊和借",
                "　船的事我來辦就好了。』"
              ]
            ]
          }
        }
      ]
    },
    "0x3286e#0": {
      "script": "ch01.json",
      "scene_index": 0,
      "lines": [
        {
          "line": 0,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 0,
            "utterance": 0,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『累死了，",
                "　大家休息一下吧！』"
              ]
            ]
          }
        },
        {
          "line": 1,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 0,
            "utterance": 1,
            "control": "FFEF",
            "operand": 4,
            "pages": [
              [
                "『聽說再越過這片海洋",
                "　就到馬拉大陸了，",
                "　我們先在此休息一會兒，"
              ],
              [
                "　等海水漲潮適合上岸的時候",
                "　船夫就會來接我們。』"
              ]
            ]
          }
        },
        {
          "line": 2,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 0,
            "utterance": 2,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『好極了。悠妮，",
                "妳．．嗯，坐了這麼久的船，",
                "有點累吧？』"
              ]
            ]
          }
        },
        {
          "line": 3,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 0,
            "utterance": 3,
            "control": "FFEF",
            "operand": 9,
            "pages": [
              [
                "『嗯，還好。",
                "　海風吹起來真舒服啊．．』"
              ]
            ]
          }
        },
        {
          "line": 4,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 0,
            "utterance": 4,
            "control": "FFEF",
            "operand": 30,
            "pages": [
              [
                "『．．！！！』"
              ]
            ]
          }
        }
      ]
    },
    "0x328ec#1": {
      "script": "ch01.json",
      "scene_index": 1,
      "lines": [
        {
          "line": 0,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 1,
            "utterance": 0,
            "control": "FFED",
            "operand": 10,
            "pages": [
              [
                "『瞧！",
                "　竟有呆鳥在這小島上休息，",
                "　真是天上掉下來的肥肉。』"
              ]
            ]
          }
        },
        {
          "line": 1,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 1,
            "utterance": 1,
            "control": "FFED",
            "operand": 9,
            "pages": [
              [
                "『就是說嘛！",
                "　俺去通報老大支援，",
                "　你們趕快把這些小伙子擺",
                "　平。』"
              ]
            ]
          }
        }
      ]
    },
    "0x32952#2": {
      "script": "ch01.json",
      "scene_index": 1,
      "lines": [
        {
          "line": 2,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 2,
            "utterance": 0,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『亞雷斯，那群傢伙",
                "　在那裡鬼叫些什麼？』"
              ]
            ]
          }
        },
        {
          "line": 3,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 2,
            "utterance": 1,
            "control": "FFEE",
            "operand": 4,
            "pages": [
              [
                "『嗯．．嘿，好像是船夫",
                "　提到過的海盜耶！』"
              ]
            ]
          }
        },
        {
          "line": 4,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 2,
            "utterance": 2,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『海盜？",
                "　是要來搶劫我們的嗎？』"
              ]
            ]
          }
        },
        {
          "line": 5,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 2,
            "utterance": 3,
            "control": "FFEE",
            "operand": 4,
            "pages": [
              [
                "『豈止搶劫而已，聽說",
                "　這批海盜橫行馬拉大陸沿",
                "　海，殺人越貨無所不為。』"
              ]
            ]
          }
        },
        {
          "line": 6,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 2,
            "utterance": 4,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『什麼！要打架我奉陪，",
                "　要搶劫嘛門都沒有。"
              ],
              [
                "　亞雷斯，好久沒活動活動",
                "　筋骨了，你沒問題吧！』"
              ]
            ]
          }
        },
        {
          "line": 7,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 2,
            "utterance": 5,
            "control": "FFEE",
            "operand": 4,
            "pages": [
              [
                "『豈止沒問題而已，",
                "　我手癢難熬，",
                "　都快受不了啦！』"
              ]
            ]
          }
        },
        {
          "line": 8,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 2,
            "utterance": 6,
            "control": "FFED",
            "operand": 11,
            "pages": [
              [
                "『喂！小子們，",
                "　乖乖的把身上的錢財和",
                "　那個漂亮小妞交出來，"
              ],
              [
                "　我們就在老大面前說說好話",
                "　保你們一命！不然．』"
              ]
            ]
          }
        },
        {
          "line": 9,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 2,
            "utterance": 7,
            "control": "FFEE",
            "operand": 9,
            "pages": [
              [
                "『什麼是漂亮小妞？",
                "　是指我嗎？』"
              ]
            ]
          }
        },
        {
          "line": 10,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 2,
            "utterance": 8,
            "control": "FFEE",
            "operand": 4,
            "pages": [
              [
                "『不是啦！那是．』"
              ]
            ]
          }
        },
        {
          "line": 11,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 2,
            "utterance": 9,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『可惡，",
                "　你們這些亂說話的海盜，",
                "　我要把你們全宰了！』"
              ]
            ]
          }
        },
        {
          "line": 12,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 2,
            "utterance": 10,
            "control": "FFED",
            "operand": 10,
            "pages": [
              [
                "『啊呀，",
                "　看來他們想抵抗呢！』"
              ]
            ]
          }
        },
        {
          "line": 13,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 2,
            "utterance": 11,
            "control": "FFED",
            "operand": 11,
            "pages": [
              [
                "『那就殺無赦！",
                "　上啊！』"
              ]
            ]
          }
        }
      ]
    }
  }
