  "overrides": {},
  "dialogue_overrides": {
    "0x22f1f#9": {
      "script": "ch01.json",
      "scene_index": 7,
      "lines": [
        {
          "line": 0,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 9,
            "utterance": 0,
            "control": "FFEE",
            "operand": 4,
            "pages": [
              [
                "『多謝老爹和您公子的幫忙，",
                "　我們才能順利打敗海盜。』"
              ]
            ]
          }
        },
        {
          "line": 1,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 9,
            "utterance": 1,
            "control": "FFEF",
            "operand": 3,
            "pages": [
              [
                "『那裡！我和小子住在這島上",
                "　除了偶爾出去遊歷外，平常",
                "　也閒來無事，幫你們打打海"
              ],
              [
                "　盜，不算什麼啦！",
                "　對了，說到這個，老頭子我",
                "　倒有個請求。』"
              ]
            ]
          }
        },
        {
          "line": 2,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 9,
            "utterance": 2,
            "control": "FFEE",
            "operand": 4,
            "pages": [
              [
                "『老爹您說說看。』"
              ]
            ]
          }
        },
        {
          "line": 3,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 9,
            "utterance": 3,
            "control": "FFEF",
            "operand": 3,
            "pages": [
              [
                "『我瞧我這小子和你們滿合得",
                "　來的，希望你們能帶他同行",
                "　，讓他出去見識見識，歷練"
              ],
              [
                "　一番。我從小教了他不少武",
                "　術，當你們有麻煩的時候，",
                "　相信他也可以幫上一點忙。",
                "　』"
              ]
            ]
          }
        },
        {
          "line": 4,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 9,
            "utterance": 4,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『這個好像有點．．』"
              ]
            ]
          }
        },
        {
          "line": 5,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 9,
            "utterance": 5,
            "control": "FFEE",
            "operand": 4,
            "pages": [
              [
                "『哎！老爹您這個請求當然是",
                "　沒問題的啦！悠妮妳說是不",
                "　是？』"
              ]
            ]
          }
        },
        {
          "line": 6,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 9,
            "utterance": 6,
            "control": "FFEE",
            "operand": 9,
            "pages": [
              [
                "『多一個同伴，",
                "　路上也比較熱鬧啊！』"
              ]
            ]
          }
        },
        {
          "line": 7,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 9,
            "utterance": 7,
            "control": "FFEF",
            "operand": 3,
            "pages": [
              [
                "『真是太謝謝各位了。",
                "　小子啊，來向大家打個招呼",
                "　！』"
              ]
            ]
          }
        },
        {
          "line": 8,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 9,
            "utterance": 8,
            "control": "FFEF",
            "operand": 1,
            "pages": [
              [
                "『我．我叫哈諾，",
                "　以後請．請大家多多指教",
                "　。』"
              ]
            ]
          }
        },
        {
          "line": 9,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 9,
            "utterance": 9,
            "control": "FFEE",
            "operand": 4,
            "pages": [
              [
                "『以後你就是我們的伙伴了。",
                "　平時我們要好好相處，",
                "　遇到危難時要同心協力，",
                "　好嗎？』"
              ]
            ]
          }
        },
        {
          "line": 10,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 9,
            "utterance": 10,
            "control": "FFEF",
            "operand": 1,
            "pages": [
              [
                "『好．好的。』"
              ]
            ]
          }
        },
        {
          "line": 11,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 9,
            "utterance": 11,
            "control": "FFEF",
            "operand": 3,
            "pages": [
              [
                "『漲潮的時間也差不多到了，",
                "　你們可以準備上路了。",
                "　我這小子就拜託你們啦！』"
              ]
            ]
          }
        },
        {
          "line": 12,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_001",
            "string_index": 9,
            "utterance": 12,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『老爹您放心吧！",
                "　我們走囉！』"
              ]
            ]
          }
        }
      ]
    }
  }
}
