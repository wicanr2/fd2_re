  "dialogue_overrides": {
    "0x24e1b#6": {
      "script": "ch25.json",
      "scene_index": 2,
      "lines": [
        { "line": 0, "upper": true, "native_dialogue": { "source_dat": "FDTXT_025", "string_index": 6, "utterance": 0, "control": "FFED", "operand": 16, "pages": [["『真是驚險的一戰！約拿老頭", "　，你從哪裡找來這些生力軍", "　？如果沒有他們，這一戰的"], ["　結果就會改觀了。』"]] } },
        { "line": 1, "upper": false, "native_dialogue": { "source_dat": "FDTXT_025", "string_index": 6, "utterance": 1, "control": "FFEE", "operand": 21, "pages": [["『他們是一群富正義感的年輕", "　勇士，因為機緣巧合同聚一", "　堂，之後為了打倒暗中威脅"], ["　這整個大陸的敵人而和我一", "　起奮戰至今。』"]] } },
        { "line": 2, "upper": true, "native_dialogue": { "source_dat": "FDTXT_025", "string_index": 6, "utterance": 2, "control": "FFED", "operand": 16, "pages": [["『好極了，我正愁來不及召集", "　一支夠強的軍隊！據我調查", "　的結果，這熔岩洞窟中有通"], ["　道通往一個古代人的遺跡，", "　據說從那裡可以直達黃金的", "　城堡。』"]] } },
        { "line": 3, "upper": false, "native_dialogue": { "source_dat": "FDTXT_025", "string_index": 6, "utterance": 3, "control": "FFEE", "operand": 0, "pages": [["『所謂黃金的城堡，就是指敵", "　人的根據地嗎？』"]] } },
        { "line": 4, "upper": false, "native_dialogue": { "source_dat": "FDTXT_025", "string_index": 6, "utterance": 4, "control": "FFEE", "operand": 21, "pages": [["『很難說，我們要去確認之後", "　才知道。』"]] } },
        { "line": 5, "upper": true, "native_dialogue": { "source_dat": "FDTXT_025", "string_index": 6, "utterance": 5, "control": "FFED", "operand": 16, "pages": [["『敵人似乎怕我們發現這一點", "　，所以剛才那傢伙企圖施用", "　魔法讓火山爆發，徹底毀滅"], ["　這條通道，但這樣也會毀了", "　惡魔族的棲息之地．幸好你", "　們及時抵達，才沒有讓那傢"], ["　伙得逞。』"]] } },
        { "line": 6, "upper": false, "native_dialogue": { "source_dat": "FDTXT_025", "string_index": 6, "utterance": 6, "control": "FFEE", "operand": 4, "pages": [["『好極了，咱們趕快前往遺跡", "　吧，這次絕不能再讓敵人搶", "　先了！』"]] } }
      ]
    },
    "0x24e62#7": {
      "script": "ch25.json",
      "scene_index": 2,
      "lines": [
        { "line": 7, "upper": true, "native_dialogue": { "source_dat": "FDTXT_025", "string_index": 7, "utterance": 0, "control": "FFEF", "operand": 29, "pages": [["『等等！』"]] } },
        { "line": 8, "upper": false, "native_dialogue": { "source_dat": "FDTXT_025", "string_index": 7, "utterance": 1, "control": "FFEE", "operand": 0, "pages": [["『咦，敵方還有漏網之魚嗎？", "　』"]] } },
        { "line": 9, "upper": true, "native_dialogue": { "source_dat": "FDTXT_025", "string_index": 7, "utterance": 2, "control": "FFEF", "operand": 29, "pages": [["『別誤會，我是來加入你們一", "　行的。』"]] } },
        { "line": 10, "upper": false, "native_dialogue": { "source_dat": "FDTXT_025", "string_index": 7, "utterance": 3, "control": "FFEE", "operand": 21, "pages": [["『你會說人類的語言？這可有", "　趣了。』"]] } },
        { "line": 11, "upper": true, "native_dialogue": { "source_dat": "FDTXT_025", "string_index": 7, "utterance": 4, "control": "FFEF", "operand": 29, "pages": [["『我是當今惡魔族之王卡爾根", "　的弟弟，王家魔法師亞奇梅", "　吉。我平日對人類和大陸上"], ["　的其他種族有很深的研究，", "　所以通曉你們的語言。』"]] } },
        { "line": 12, "upper": false, "native_dialogue": { "source_dat": "FDTXT_025", "string_index": 7, "utterance": 5, "control": "FFEE", "operand": 4, "pages": [["『你的種族剛剛才聯合火魔神", "　與我們為敵，為何現在你又", "　要加入我們？』"]] } },
        { "line": 13, "upper": true, "native_dialogue": { "source_dat": "FDTXT_025", "string_index": 7, "utterance": 6, "control": "FFEF", "operand": 29, "pages": [["『我族並不是故意要與你們為", "　敵，因為敵人以邪法控制了", "　王兄的神智，藉以命令我族"], ["　的戰士來抵擋你們的攻勢。", "　我看穿這一點之後，敵人便", "　假王兄之手將我監禁起來，"], ["　還好你們阻止了他們，不然", "　整個惡魔族可能會就此滅亡", "　。』"]] } },
        { "line": 14, "upper": false, "native_dialogue": { "source_dat": "FDTXT_025", "string_index": 7, "utterance": 7, "control": "FFEE", "operand": 21, "pages": [["『原來如此，你對敵人的所知", "　有多少？』"]] } },
        { "line": 15, "upper": true, "native_dialogue": { "source_dat": "FDTXT_025", "string_index": 7, "utterance": 8, "control": "FFEF", "operand": 29, "pages": [["『我相信他們和古代人的遺跡", "　以及黃金城絕對有關連，他", "　們可能是從附近的遺跡來到"], ["　這個世界的，所以當務之急", "　是經由本地的通道前往遺跡", "　，以免他們再度增援。』"]] } },
        { "line": 16, "upper": true, "native_dialogue": { "source_dat": "FDTXT_025", "string_index": 7, "utterance": 9, "control": "FFEF", "operand": 16, "pages": [["『好極了，那接下來便由你來", "　帶路了。』"]] } },
        { "line": 17, "upper": true, "native_dialogue": { "source_dat": "FDTXT_025", "string_index": 7, "utterance": 10, "control": "FFEF", "operand": 29, "pages": [["『樂意之至！我們這就走吧！", "　』"]] } }
      ]
    }
  },
