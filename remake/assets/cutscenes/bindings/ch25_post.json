    "0x24f43#6": {
      "script": "ch26.json",
      "scene_index": 2,
      "lines": [
        {
          "line": 4,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_026",
            "string_index": 6,
            "utterance": 0,
            "control": "FFEE",
            "operand": 29,
            "pages": [
              [
                "『好極了，我們迅速擊潰了敵",
                "　方機甲兵，現在可以馬上前",
                "　往遺跡．嘿，隊伍裏怎麼有",
                "　個敵方機甲兵？』"
              ]
            ]
          }
        },
        {
          "line": 5,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_026",
            "string_index": 6,
            "utterance": 1,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『那是悠妮幫我們拉進伙的，",
                "　她和機甲兵一直很有緣。』"
              ]
            ]
          }
        },
        {
          "line": 6,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_026",
            "string_index": 6,
            "utterance": 2,
            "control": "FFEE",
            "operand": 4,
            "pages": [
              [
                "『是啊，她初次和我們相遇",
                "　時就帶著蓋亞。』"
              ]
            ]
          }
        },
        {
          "line": 7,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_026",
            "string_index": 6,
            "utterance": 3,
            "control": "FFEE",
            "operand": 29,
            "pages": [
              [
                "『是這樣嗎？．悠妮小姐，我",
                "　看妳好像知道機甲兵的啟動",
                "　碼，是吧？』"
              ]
            ]
          }
        },
        {
          "line": 8,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_026",
            "string_index": 6,
            "utterance": 4,
            "control": "FFEE",
            "operand": 9,
            "pages": [
              [
                "『啊？啟動碼．那是什麼東西",
                "　？我不知道！』"
              ]
            ]
          }
        }
      ]
    },
    "0x24f43#5": {
      "script": "ch26.json",
      "scene_index": 2,
      "lines": [
        {
          "line": 0,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_026",
            "string_index": 5,
            "utterance": 0,
            "control": "FFEE",
            "operand": 29,
            "pages": [
              [
                "『好極了，我們迅速擊潰了敵",
                "　方機甲兵，現在可以馬上前",
                "　往遺跡，不過我們還是對敵"
              ],
              [
                "　人的底細一無所知．．悠妮",
                "　小姐，妳的護衛也是古代人",
                "　所造的機甲兵吧？』"
              ]
            ]
          }
        },
        {
          "line": 1,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_026",
            "string_index": 5,
            "utterance": 1,
            "control": "FFEE",
            "operand": 4,
            "pages": [
              [
                "『是的，她初次和我們相遇時",
                "　就帶著蓋亞。』"
              ]
            ]
          }
        },
        {
          "line": 2,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_026",
            "string_index": 5,
            "utterance": 2,
            "control": "FFEE",
            "operand": 29,
            "pages": [
              [
                "『是這樣嗎？．悠妮小姐，我",
                "　看妳一定知道些什麼，有關",
                "　古代人和這批機甲兵的秘密"
              ],
              [
                "　．．是吧？』"
              ]
            ]
          }
        },
        {
          "line": 3,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_026",
            "string_index": 5,
            "utterance": 3,
            "control": "FFEE",
            "operand": 9,
            "pages": [
              [
                "『古代人？機甲兵？．．那是",
                "　什麼東西？我不知道！』"
              ]
            ]
          }
        }
      ]
    },
    "0x24f7e#7": {
      "script": "ch26.json",
      "scene_index": 2,
      "lines": [
        {
          "line": 9,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_026",
            "string_index": 7,
            "utterance": 0,
            "control": "FFEE",
            "operand": 29,
            "pages": [
              [
                "『是嗎？悠妮小姐，我看妳一",
                "　定知道！妳到底是從哪裡來",
                "　的？妳絕不是一般人類！為"
              ],
              [
                "　了我們大家，把話說個清楚",
                "　吧！』"
              ]
            ]
          }
        },
        {
          "line": 10,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_026",
            "string_index": 7,
            "utterance": 1,
            "control": "FFEE",
            "operand": 9,
            "pages": [
              [
                "『．不．不要再說了！．我什",
                "　麼都不知道．．』"
              ]
            ]
          }
        }
      ]
    },
    "0x24fc4#9": {
      "script": "ch26.json",
      "scene_index": 3,
      "lines": [
        {
          "line": 0,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_026",
            "string_index": 9,
            "utterance": 0,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『亞奇梅吉，夠了！你要是把",
                "　她弄哭了，我絕不饒你！』"
              ]
            ]
          }
        },
        {
          "line": 1,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_026",
            "string_index": 9,
            "utterance": 1,
            "control": "FFEE",
            "operand": 21,
            "pages": [
              [
                "『．算啦，不要逼問她了，問",
                "　這個機甲兵也是一樣．．喂",
                "　，那個機甲兵。』"
              ]
            ]
          }
        },
        {
          "line": 2,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_026",
            "string_index": 9,
            "utterance": 2,
            "control": "FFEF",
            "operand": 31,
            "pages": [
              [
                "『01279943渥德，命令確認。",
                "　』"
              ]
            ],
            "glyph_pages": [
              [
                [
                  "『",
                  "01",
                  "27",
                  "99",
                  "43",
                  "渥",
                  "德",
                  "，",
                  "命",
                  "令",
                  "確",
                  "認",
                  "。"
                ],
                [
                  "　",
                  "』"
                ]
              ]
            ]
          }
        },
        {
          "line": 3,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_026",
            "string_index": 9,
            "utterance": 3,
            "control": "FFEE",
            "operand": 21,
            "pages": [
              [
                "『你叫渥德嗎？請回答我的問",
                "　題。』"
              ]
            ]
          }
        },
        {
          "line": 4,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_026",
            "string_index": 9,
            "utterance": 4,
            "control": "FFEF",
            "operand": 31,
            "pages": [
              [
                "『了解，記憶庫連接，資料載",
                "　入待命。請指示。』"
              ]
            ]
          }
        },
        {
          "line": 5,
          "upper": false,
          "native_dialogue": {
            "source_dat": "FDTXT_026",
            "string_index": 9,
            "utterance": 5,
            "control": "FFEE",
            "operand": 21,
            "pages": [
              [
                "『你們的種族來自何方？領導",
                "　者又是誰？』"
              ]
            ]
          }
        },
        {
          "line": 6,
          "upper": true,
          "native_dialogue": {
            "source_dat": "FDTXT_026",
            "string_index": 9,
            "utterance": 6,
            "control": "FFEF",
            "operand": 31,
            "pages": [
              [
                "『記憶庫搜尋，資料#73324：",
                "　01279943渥德隸屬第六機甲",
                "　戰鬥團第三戰鬥中隊，全師"
              ],
              [
                "　團由第一空中要塞建造，在",
                "　執行第七號戰鬥防衛命令時",
                "　，經由轉送站送到地表。我"
              ],
              [
                "　們的領導者是全能的創造者",
                "　，他可以任意創造機械和生",
                "　命，是這個大地的主宰者，"
              ],
              [
                "　我們並不知道領導者的名字",
                "　，那不在我們的記憶庫領域",
                "　之內。』"
              ]
            ],
