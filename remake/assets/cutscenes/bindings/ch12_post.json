              }
            },
            {
              "line": 1,
              "upper": false,
              "native_dialogue": {
                "source_dat": "FDTXT_013",
                "string_index": 9,
                "utterance": 7,
                "control": "FFEE",
                "operand": 4,
                "pages": [
                  [
                    "『典型的索爾作風．．不過",
                    "　也不失為一個好方法。』"
