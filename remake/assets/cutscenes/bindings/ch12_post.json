              "upper": false,
              "native_dialogue": {
                "source_dat": "FDTXT_013",
                "string_index": 9,
                "utterance": 11,
                "control": "FFEE",
                "operand": 0,
                "pages": [
                  [
                    "『既然如此，那我們稍事休息",
                    "　之後就出發吧！』"
                  ]
                ]
              }
            }
