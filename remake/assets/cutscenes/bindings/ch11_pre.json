              "line": 3,
              "upper": true,
              "native_dialogue": {
                "source_dat": "FDTXT_012",
                "string_index": 0,
                "utterance": 5,
                "control": "FFEF",
                "operand": 17,
                "pages": [
                  [
                    "『如果你能打敗這些獸人救我",
                    "　一命，我不但告訴你為什麼",
                    "　還可以額外告訴你一個大秘"
                  ],
                  [
                    "　密！』"
