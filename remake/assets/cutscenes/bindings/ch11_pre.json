              }
            },
            {
              "line": 2,
              "upper": false,
              "native_dialogue": {
                "source_dat": "FDTXT_012",
                "string_index": 0,
                "utterance": 4,
                "control": "FFEE",
                "operand": 14,
                "pages": [
                  [
                    "『你為什麼會被獸人追殺呢？",
                    "　我好想知道，",
                    "　趕快告訴我！』"
                  ]
                ]
              }
            },
