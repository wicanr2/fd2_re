          "control": "FFED",
          "operand": 33,
          "pages": [
            [
              "『可惡．國王陛下，我不能再",
              "　護衛您了．請原諒屬下的",
              "　無能．』"
            ]
          ]
        },
        "native_event_id": 24
      },
      {
        "type": "dialogue",
        "native_source": "0x34906",
        "native_text_index": 3,
        "native_dialogue_ref": {
          "script": "assets/story/ch07.json",
          "scene_index": 3,
          "line": 1,
          "source_dat": "FDTXT_007",
          "string_index": 3,
          "utterance": 1,
          "control": "FFEE",
          "operand": 8,
          "pages": [
            [
              "『你弄錯了，我們不是來加害",
              "　國王的！』"
            ]
          ]
        },
        "native_event_id": 24
      },
      {
        "type": "dialogue",
        "native_source": "0x34906",
        "native_text_index": 3,
        "native_dialogue_ref": {
          "script": "assets/story/ch07.json",
          "scene_index": 3,
          "line": 2,
          "source_dat": "FDTXT_007",
          "string_index": 3,
          "utterance": 2,
          "control": "FFED",
          "operand": 33,
          "pages": [
            [
              "『是嗎？．那麼．前些日子到",
              "　底是誰．．啊．．』"
            ]
          ]
        },
        "native_event_id": 24
      }
    ]
  }
