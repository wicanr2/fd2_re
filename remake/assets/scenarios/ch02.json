            "source_dat": "FDTXT_002",
            "string_index": 4,
            "utterance": 1,
            "control": "FFED",
            "operand": 22,
            "pages": [
              [
                "『好像和別人打的正起勁呢！",
                "　』"
              ]
            ]
          },
          "native_event_id": 6,
          "camp": "ally"
        },
        {
          "type": "dialogue",
          "native_source": "0x34491",
          "native_text_index": 4,
          "native_dialogue_ref": {
            "script": "assets/story/ch02.json",
            "scene_index": 1,
            "line": 2,
            "source_dat": "FDTXT_002",
            "string_index": 4,
            "utterance": 2,
            "control": "FFED",
            "operand": 23,
            "pages": [
              [
                "『我看到有漏網之魚向這裡逃",
                "　來呢！我們先打發了他們再",
                "　說！』"
              ]
            ]
          },
          "native_event_id": 6,
          "camp": "ally"
        },
        {
          "type": "dialogue",
          "native_source": "0x34491",
          "native_text_index": 4,
          "native_dialogue_ref": {
            "script": "assets/story/ch02.json",
            "scene_index": 1,
            "line": 3,
            "source_dat": "FDTXT_002",
            "string_index": 4,
            "utterance": 3,
            "control": "FFED",
            "operand": 8,
            "pages": [
              [
                "『救命啊！這裡又有強盜出現",
                "　了！』"
              ]
            ]
          },
          "native_event_id": 6,
          "camp": "ally"
        },
        {
          "type": "dialogue",
