            "operand": 21,
            "pages": [
              [
                "『咦！弟兄們在幹什麼？",
                "　他們早該把事情辦好了吧",
                "　！』"
              ]
            ]
          },
          "native_event_id": 6,
          "camp": "ally"
        },
        {
          "type": "dialogue",
