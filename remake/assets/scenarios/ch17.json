  "native_death_programs": {
    "2:41": [
      {
        "type": "dialogue",
        "native_source": "0x35009",
        "native_text_index": 3,
        "native_dialogue_ref": {
          "script": "assets/story/ch17.json",
          "scene_index": 1,
          "line": 9,
          "source_dat": "FDTXT_017",
          "string_index": 3,
          "utterance": 0,
          "control": "FFED",
          "operand": 16,
          "pages": [
            [
              "『為什麼．為什麼這些下賤的",
              "　人類居然能打倒我？．．",
              "　主人，救救我．．』"
            ]
          ]
        },
        "native_event_id": 41
      },
      {
        "type": "native_death_op",
        "native_source": "0x34fff",
        "native_death_op": {
          "op": "reward",
          "kind": 0,
          "value": 213
        },
        "native_event_id": 41
      },
      {
        "type": "dialogue",
        "native_source": "0x35041",
        "native_text_index": 4,
        "native_dialogue_ref": {
          "script": "assets/story/ch17.json",
          "scene_index": 2,
          "line": 0,
          "source_dat": "FDTXT_017",
          "string_index": 4,
          "utterance": 0,
          "control": "FFEE",
          "operand": 17,
          "pages": [
            [
              "『咦！這可不是．「冰之眼」",
              "　寶石？原來是在冰魔神的",
              "　身上．．』"
            ]
          ]
        },
        "native_event_id": 41
      },
      {
        "type": "dialogue",
        "native_source": "0x35041",
        "native_text_index": 4,
        "native_dialogue_ref": {
          "script": "assets/story/ch17.json",
          "scene_index": 2,
          "line": 1,
          "source_dat": "FDTXT_017",
          "string_index": 4,
          "utterance": 1,
          "control": "FFEE",
          "operand": 18,
          "pages": [
            [
              "『你也知道「魔眼寶石」的事",
              "　？』"
            ]
          ]
        },
        "native_event_id": 41
      },
      {
        "type": "dialogue",
        "native_source": "0x35041",
        "native_text_index": 4,
        "native_dialogue_ref": {
          "script": "assets/story/ch17.json",
          "scene_index": 2,
          "line": 2,
          "source_dat": "FDTXT_017",
          "string_index": 4,
          "utterance": 2,
          "control": "FFEE",
          "operand": 17,
          "pages": [
            [
              "『嗯，自從我知道某個古老的",
              "　傳說以來，就一直在追尋",
              "　其中的秘密。但為什麼這"
            ],
            [
              "　些傢伙會擁有其中之一？",
              "　．．』"
            ]
          ]
        },
        "native_event_id": 41
      },
      {
        "type": "dialogue",
        "native_source": "0x35041",
        "native_text_index": 4,
        "native_dialogue_ref": {
          "script": "assets/story/ch17.json",
          "scene_index": 2,
          "line": 3,
          "source_dat": "FDTXT_017",
          "string_index": 4,
          "utterance": 3,
          "control": "FFEE",
          "operand": 18,
          "pages": [
            [
              "『我們也正在調查這一點，目",
              "　前唯一可以肯定的是，這",
              "　絕對不會是什麼好事．嗯"
            ],
            [
              "　這件事還是等打完仗再來",
              "　談好了．．』"
            ]
          ]
        },
        "native_event_id": 41
      },
      {
        "type": "dialogue",
        "native_source": "0x35041",
        "native_text_index": 4,
        "native_dialogue_ref": {
          "script": "assets/story/ch17.json",
          "scene_index": 2,
          "line": 4,
          "source_dat": "FDTXT_017",
          "string_index": 4,
          "utterance": 4,
          "control": "FFEE",
          "operand": 17,
          "pages": [
            [
              "『也好，反正這場仗已是勝利",
              "　在望了！』"
            ]
          ]
        },
        "native_event_id": 41
      }
    ]
