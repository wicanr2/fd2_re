          "string_index": 3,
          "utterance": 2,
          "control": "FFED",
          "operand": 11,
          "pages": [
            [
              "『．為了．為了得到王家的至",
              "　寶「黃金徽章」．那是．』"
            ]
          ]
        },
        "native_event_id": 34
      },
      {
        "type": "dialogue",
        "native_source": "0x34906",
        "native_text_index": 3,
