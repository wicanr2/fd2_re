              "　究竟有何目的？』"
            ]
          ]
        },
        "native_event_id": 34
      },
      {
        "type": "dialogue",
        "native_source": "0x34906",
        "native_text_index": 3,
        "native_dialogue_ref": {
          "script": "assets/story/ch10.json",
