            "utterance": 0,
            "control": "FFEF",
            "operand": 1,
            "pages": [
              [
                "『老爸！老爸！"
              ]
            ]
          }
        },
        {
          "type": "native_range_zero",
          "native_source": "0x34250",
          "native_event_id": 0
        },
        {
          "type": "spawn_group",
          "groups": [
            7
          ],
          "camp": "own",
          "act_immediately": false,
          "native_spawns": [
            {
              "group": 7,
              "via": "spawn_group",
              "source": "0x3425c",
              "raw_placement_gate": 0
            }
          ],
          "native_event_id": 0
        },
        {
          "type": "redraw",
          "native_source": "0x34266",
          "native_event_id": 0
        },
        {
          "type": "delay",
          "native_source": "0x34270",
          "ms": 100,
          "native_event_id": 0
        },
        {
          "type": "native_acting",
          "native_source": "0x3427a",
          "native_acting": {
            "resource": 8,
            "source": "0x3427a"
          },
          "native_event_id": 0
        },
        {
          "type": "dialogue",
          "native_source": "0x342a6",
          "native_event_id": 0,
          "native_text_index": 3,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 2,
            "line": 0,
            "source_dat": "FDTXT_001",
            "string_index": 3,
            "utterance": 0,
            "control": "FFEF",
            "operand": 3,
            "pages": [
              [
                "『真是的，吵的要命，",
                "　到底在搞什麼．』"
              ]
            ]
          }
        },
        {
          "type": "dialogue",
          "native_source": "0x342a6",
          "native_event_id": 0,
          "native_text_index": 3,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 2,
            "line": 1,
            "source_dat": "FDTXT_001",
            "string_index": 3,
            "utterance": 1,
            "control": "FFEF",
            "operand": 1,
            "pages": [
              [
                "『老爸，",
                "　有人在島上打架呢！』"
              ]
            ]
          }
        },
        {
          "type": "dialogue",
          "native_source": "0x342a6",
          "native_event_id": 0,
          "native_text_index": 3,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 2,
            "line": 2,
            "source_dat": "FDTXT_001",
            "string_index": 3,
            "utterance": 2,
            "control": "FFEF",
            "operand": 3,
            "pages": [
              [
                "『什麼？待我看看．",
                "　啊哈，可不是海盜",
                "　在打劫旅客嗎？"
              ],
              [
                "　居然在我們門前搶人，",
                "　膽子不小啊！』"
              ]
            ]
          }
        },
        {
          "type": "dialogue",
          "native_source": "0x342a6",
          "native_event_id": 0,
          "native_text_index": 3,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 2,
            "line": 3,
            "source_dat": "FDTXT_001",
            "string_index": 3,
            "utterance": 3,
            "control": "FFEF",
            "operand": 1,
            "pages": [
              [
                "『就是說啊！",
                "　老爸，您說這該怎麼辦？』"
              ]
            ]
          }
        },
        {
          "type": "dialogue",
          "native_source": "0x342a6",
          "native_event_id": 0,
          "native_text_index": 3,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 2,
            "line": 4,
            "source_dat": "FDTXT_001",
            "string_index": 3,
            "utterance": 4,
            "control": "FFEF",
            "operand": 3,
            "pages": [
              [
                "『小子啊，",
                "　這可是絕佳的歷練機會，",
                "　我們就幫他們一個忙吧！』"
              ]
            ]
          }
        },
        {
          "type": "dialogue",
          "native_source": "0x342a6",
          "native_event_id": 0,
          "native_text_index": 3,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 2,
            "line": 5,
            "source_dat": "FDTXT_001",
            "string_index": 3,
            "utterance": 5,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『老頭子，",
                "　你們是來幹什麼的？",
                "　若不想受傷就別過來",
                "　湊熱鬧！』"
              ]
            ]
          }
        },
        {
          "type": "dialogue",
          "native_source": "0x342a6",
          "native_event_id": 0,
          "native_text_index": 3,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 2,
            "line": 6,
            "source_dat": "FDTXT_001",
            "string_index": 3,
            "utterance": 6,
            "control": "FFEF",
            "operand": 3,
            "pages": [
              [
                "『別緊張，小伙子，",
                "　我們是來幫你們打退海盜",
                "　的。』"
              ]
            ]
          }
        },
        {
          "type": "dialogue",
          "native_source": "0x342a6",
          "native_event_id": 0,
          "native_text_index": 3,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 2,
            "line": 7,
            "source_dat": "FDTXT_001",
            "string_index": 3,
            "utterance": 7,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『什麼？就這一點海盜，",
                "　還用不著你們來幫忙！",
                "　回去回去！』"
              ]
            ]
          }
        },
        {
          "type": "dialogue",
          "native_source": "0x342a6",
          "native_event_id": 0,
          "native_text_index": 3,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 2,
            "line": 8,
            "source_dat": "FDTXT_001",
            "string_index": 3,
            "utterance": 8,
            "control": "FFEE",
            "operand": 4,
            "pages": [
              [
                "『哎，索爾，人家是好意",
                "　要幫忙，你也說幾句",
                "　好聽一點的吧！』"
              ]
            ]
          }
        },
        {
          "type": "dialogue",
          "native_source": "0x342a6",
          "native_event_id": 0,
          "native_text_index": 3,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 2,
            "line": 9,
            "source_dat": "FDTXT_001",
            "string_index": 3,
            "utterance": 9,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『這樣嗎？好吧，那就．喂，",
                "　老頭子，如果你要幫忙的話",
                "　就先說聲多謝了！』"
              ]
            ]
          }
        },
        {
          "type": "dialogue",
          "native_source": "0x342a6",
          "native_event_id": 0,
          "native_text_index": 3,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 2,
            "line": 10,
            "source_dat": "FDTXT_001",
            "string_index": 3,
            "utterance": 10,
            "control": "FFEE",
            "operand": 3,
            "pages": [
              [
                "『這些年輕人真有精神啊！",
                "　小子，我們上！』"
              ]
            ]
          }
        },
        {
          "type": "dialogue",
          "native_source": "0x342a6",
          "native_event_id": 0,
          "native_text_index": 3,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 2,
            "line": 11,
            "source_dat": "FDTXT_001",
            "string_index": 3,
            "utterance": 11,
            "control": "FFEF",
            "operand": 1,
            "pages": [
              [
                "『好的，老爸！』"
              ]
            ]
          }
        },
        {
          "type": "reset_pose",
          "native_source": "0x342ae",
          "native_event_id": 0
        }
      ]
    },
