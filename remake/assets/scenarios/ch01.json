        },
        {
          "type": "dialogue",
          "native_source": "0x34313",
          "native_event_id": 1,
          "native_text_index": 4,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 3,
            "line": 0,
            "source_dat": "FDTXT_001",
            "string_index": 4,
            "utterance": 0,
            "control": "FFED",
            "operand": 15,
            "pages": [
              [
                "『咦，",
                "　弟兄們好像陷入苦戰呢！』"
              ]
            ]
          }
        },
        {
          "type": "dialogue",
          "native_source": "0x34313",
          "native_event_id": 1,
          "native_text_index": 4,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 3,
            "line": 1,
            "source_dat": "FDTXT_001",
            "string_index": 4,
            "utterance": 1,
            "control": "FFED",
            "operand": 16,
            "pages": [
              [
                "『那還等什麼！我們上吧！』"
              ]
            ]
          }
        }
      ]
