            "string_index": 6,
            "utterance": 0,
            "control": "FFEF",
            "operand": 68,
            "pages": [
              [
                "『咦！又有海盜在此逞兇了，",
                "　現在正是我們海防隊建功",
                "　的良機！』"
              ]
            ]
          }
        },
        {
          "type": "dialogue",
          "native_source": "0x343dd",
          "native_event_id": 3,
          "native_text_index": 6,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 4,
            "line": 1,
            "source_dat": "FDTXT_001",
            "string_index": 6,
            "utterance": 1,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『今天可真是熱鬧啊！",
                "　你們又是來幹什麼的？』"
              ]
            ]
          }
        },
        {
          "type": "dialogue",
          "native_source": "0x343dd",
          "native_event_id": 3,
          "native_text_index": 6,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 4,
            "line": 2,
            "source_dat": "FDTXT_001",
            "string_index": 6,
            "utterance": 2,
            "control": "FFEF",
            "operand": 68,
            "pages": [
              [
                "『我們是亞克斯王國的海岸巡",
                "　防隊，消滅肆虐沿海的海盜",
                "　本是我們的職責，這些海盜"
              ],
              [
                "　就交給我們來處理，請各位",
                "　放心！』"
              ]
            ]
          }
        },
        {
          "type": "dialogue",
          "native_source": "0x343dd",
          "native_event_id": 3,
          "native_text_index": 6,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 4,
            "line": 3,
            "source_dat": "FDTXT_001",
            "string_index": 6,
            "utterance": 3,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『鬼扯，我們打的正高興，",
                "　才不需要你們來攪局！』"
              ]
            ]
          }
        },
        {
          "type": "dialogue",
          "native_source": "0x343dd",
          "native_event_id": 3,
          "native_text_index": 6,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 4,
            "line": 4,
            "source_dat": "FDTXT_001",
            "string_index": 6,
            "utterance": 4,
            "control": "FFEE",
            "operand": 4,
            "pages": [
              [
                "『索爾啊，",
                "　我們就要踏進人家的地盤，",
                "　至少對人家客氣點吧！』"
              ]
            ]
          }
        },
        {
          "type": "dialogue",
          "native_source": "0x343dd",
          "native_event_id": 3,
          "native_text_index": 6,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 4,
            "line": 5,
            "source_dat": "FDTXT_001",
            "string_index": 6,
            "utterance": 5,
            "control": "FFEF",
            "operand": 68,
            "pages": [
              [
                "『沒關係！",
                "　我們這就來幫忙了！』"
              ]
            ]
          }
        }
      ]
    }
