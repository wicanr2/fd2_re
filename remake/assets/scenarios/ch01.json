          ],
          "camp": "enemy",
          "native_spawns": [
            {
              "group": 5,
              "via": "spawn_group_with_intro",
              "source": "0x34336",
              "raw_placement_gate": 0,
              "following_acting": {
                "resource": 4,
                "source": "0x3434f"
              }
            }
          ],
          "native_event_id": 2
        },
        {
          "type": "reset_pose",
          "native_source": "0x34357",
          "native_event_id": 2
        },
        {
          "type": "dialogue",
          "native_source": "0x34375",
          "native_event_id": 2,
          "native_text_index": 5,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 3,
            "line": 2,
            "source_dat": "FDTXT_001",
            "string_index": 5,
            "utterance": 0,
            "control": "FFEF",
            "operand": 97,
            "pages": [
              [
                "『小子們，你們在搞些什麼！",
                "　連這些小鬼都收拾不了，",
                "　還要勞動老大我出馬，",
                "　不怕給別人笑話嗎？』"
              ]
            ]
          }
        },
        {
          "type": "dialogue",
          "native_source": "0x34375",
          "native_event_id": 2,
          "native_text_index": 5,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 3,
            "line": 3,
            "source_dat": "FDTXT_001",
            "string_index": 5,
            "utterance": 1,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『哼，這難看又吵人的傢伙",
                "　又是來幹什麼的？』"
              ]
            ]
          }
        },
        {
          "type": "dialogue",
          "native_source": "0x34375",
          "native_event_id": 2,
          "native_text_index": 5,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 3,
            "line": 4,
            "source_dat": "FDTXT_001",
            "string_index": 5,
            "utterance": 2,
            "control": "FFEE",
            "operand": 4,
            "pages": [
              [
                "『大概是海盜首領吧！",
                "　總算有個像樣的對手上場了",
                "　這傢伙就交給我來處理啦！",
                "　』"
              ]
            ]
          }
        },
        {
          "type": "dialogue",
          "native_source": "0x34375",
          "native_event_id": 2,
          "native_text_index": 5,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 3,
            "line": 5,
            "source_dat": "FDTXT_001",
            "string_index": 5,
            "utterance": 3,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『那怎麼可以！",
                "　對付這種麻煩的傢伙，",
                "　當然是非我莫屬了！",
                "　讓我來！』"
              ]
            ]
          }
        },
        {
          "type": "dialogue",
          "native_source": "0x34375",
          "native_event_id": 2,
          "native_text_index": 5,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 3,
            "line": 6,
            "source_dat": "FDTXT_001",
            "string_index": 5,
            "utterance": 4,
            "control": "FFEE",
            "operand": 4,
            "pages": [
              [
                "『索爾，你真是不夠朋友！",
                "　就為了在喜歡的女孩子",
                "　面前逞能，竟然．．』"
              ]
            ]
          }
        },
        {
          "type": "dialogue",
          "native_source": "0x34375",
          "native_event_id": 2,
          "native_text_index": 5,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 3,
            "line": 7,
            "source_dat": "FDTXT_001",
            "string_index": 5,
            "utterance": 5,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『你．你胡說些什麼！",
                "　再亂說的話，我可就．．』"
              ]
            ]
          }
        },
        {
          "type": "dialogue",
          "native_source": "0x34375",
          "native_event_id": 2,
          "native_text_index": 5,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 3,
            "line": 8,
            "source_dat": "FDTXT_001",
            "string_index": 5,
            "utterance": 6,
            "control": "FFEF",
            "operand": 97,
            "pages": [
              [
                "『喂！你們兩個到底在吵些",
                "　什麼！要吵的話，等進了",
                "　地獄後再吵也不遲！』"
              ]
            ]
          }
        },
        {
          "type": "dialogue",
          "native_source": "0x34375",
          "native_event_id": 2,
          "native_text_index": 5,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 3,
            "line": 9,
            "source_dat": "FDTXT_001",
            "string_index": 5,
            "utterance": 7,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『你煩什麼煩！",
                "　滾一邊去！』"
              ]
            ]
          }
        },
        {
          "type": "dialogue",
          "native_source": "0x34375",
          "native_event_id": 2,
          "native_text_index": 5,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 3,
            "line": 10,
            "source_dat": "FDTXT_001",
            "string_index": 5,
            "utterance": 8,
            "control": "FFEE",
            "operand": 4,
            "pages": [
              [
                "『這傢伙討厭得很，索爾，",
                "　我們不吵了，",
                "　先合力宰了他再說！』"
              ]
            ]
          }
        },
        {
          "type": "dialogue",
          "native_source": "0x34375",
          "native_event_id": 2,
          "native_text_index": 5,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 3,
            "line": 11,
            "source_dat": "FDTXT_001",
            "string_index": 5,
            "utterance": 9,
            "control": "FFEE",
            "operand": 0,
            "pages": [
              [
                "『好，就這麼辦！』"
              ]
            ]
          }
        },
        {
          "type": "dialogue",
          "native_source": "0x34375",
          "native_event_id": 2,
          "native_text_index": 5,
          "native_dialogue_ref": {
            "script": "assets/story/ch01.json",
            "scene_index": 3,
            "line": 12,
            "source_dat": "FDTXT_001",
            "string_index": 5,
            "utterance": 10,
            "control": "FFEF",
            "operand": 97,
            "pages": [
              [
                "『可惡啊！這兩個小子全不把",
                "　我放在眼裡！給我殺！",
                "　一個都別放過！』"
              ]
            ]
          }
        }
      ]
