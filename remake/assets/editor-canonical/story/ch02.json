        {
          "extensions": {
            "legacy": {
              "speaker": 0,
              "speaker_name": "索爾",
              "upper": false
            }
          },
          "line_id": "legacy/line/5bf145f103fe/scenes/2/lines/22",
          "speaker": "character/native-0",
          "text": "真是沒辦法,唉!"
