          "extensions": {
            "legacy": {
              "speaker": 0,
              "speaker_name": "索爾"
            }
          },
          "line_id": "legacy/line/8355a97601cc/scenes/1/lines/4",
          "speaker": "character/native-0",
          "text": "這些機甲衛兵還不都是一些老貨色,相信很快就可以解決掉。我們上吧!"
