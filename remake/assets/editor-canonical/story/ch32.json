              "speaker": 0,
              "speaker_name": "索爾(少年)"
            }
          },
          "line_id": "legacy/line/8cbcda4a2315/scenes/3/lines/1",
          "speaker": "character/native-0",
          "text": "我一定要去!亞雷斯,你知不知道怎麼去?"
