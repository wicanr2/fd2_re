        },
        {
          "extensions": {
            "legacy": {
              "note": "[?] 同上,稱呼對象與在場人物不符,存疑照錄",
              "speaker": 0,
              "speaker_name": "索爾(少年)"
            }
          },
          "line_id": "legacy/line/8cbcda4a2315/scenes/3/lines/5",
          "speaker": "character/native-0",
          "text": "亞雷斯,謝謝你!"
        },
