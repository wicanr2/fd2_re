            }
          },
          "line_id": "legacy/line/81dd5ef66a56/scenes/1/lines/4",
          "speaker": "legacy/speaker/81dd5ef66a56/scenes/1/lines/4",
          "text": "聖靈之塔....絕不能讓敵人侵入...."
        },
        {
          "extensions": {
