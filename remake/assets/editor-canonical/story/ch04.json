          "extensions": {
            "legacy": {
              "speaker": 27,
              "speaker_name": "巴拿羅西亞"
            }
          },
          "line_id": "legacy/line/750623f119b8/scenes/2/lines/3",
          "speaker": "character/native-27",
          "text": "贊成!贊成!"
        },
        {
          "extensions": {
            "legacy": {
              "speaker": -1,
              "speaker_name": "惡"
            }
          },
          "line_id": "legacy/line/750623f119b8/scenes/2/lines/4",
          "speaker": "legacy/speaker/750623f119b8/scenes/2/lines/4",
          "text": "好可怕!不玩了!不玩了!"
        }
      ],
      "scene_id": "legacy/scene/750623f119b8/scenes/2"
    },
    {
      "beats": [],
      "extensions": {
