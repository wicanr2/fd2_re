          },
          "line_id": "legacy/line/750623f119b8/scenes/3/lines/0",
          "speaker": "character/native-0",
          "text": "奇怪了,在這大陸上到處都遇得上強盜!"
        },
        {
          "extensions": {
            "legacy": {
              "speaker": 8,
              "speaker_name": "希莉亞"
