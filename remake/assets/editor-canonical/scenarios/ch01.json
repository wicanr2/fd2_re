            "legacy": {
              "native_dialogue_ref": {
                "control": "FFEF",
                "line": 4,
                "operand": 3,
                "pages": [
                  [
                    "『小子啊，",
                    "　這可是絕佳的歷練機會，",
                    "　我們就幫他們一個忙吧！』"
