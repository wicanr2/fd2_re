            "legacy": {
              "native_dialogue_ref": {
                "control": "FFEF",
                "line": 2,
                "operand": 3,
                "pages": [
                  [
                    "『什麼？待我看看．",
                    "　啊哈，可不是海盜",
                    "　在打劫旅客嗎？"
                  ],
                  [
                    "　居然在我們門前搶人，",
                    "　膽子不小啊！』"
