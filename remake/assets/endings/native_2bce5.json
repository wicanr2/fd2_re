        {"control_source": "fdtxt", "control": "FFEE", "operand": 24, "pages": [["『嗯，我覺得身上重新充滿了", "　力量！』"]]},
        {"control_source": "fdtxt", "control": "FFEF", "operand": 126, "pages": [["『哼哼．想不到你還有這種能", "　力，這樣不過能讓這些螻蟻", "　撐久一點而已．勝利仍將會"], ["　屬於我！』"]]},
        {"control_source": "fdtxt", "control": "FFEE", "operand": 0, "pages": [["『少囉唆了，要打架就過來啊", "　！』"]]},
        {"control_source": "fdtxt", "control": "FFEF", "operand": 126, "pages": [["『大地的代言者，讓這些愚者", "　知道創造者的威嚴！』"]]},
        {"control_source": "fdtxt", "control": "FFEF", "operand": 122, "pages": [["『地魔神領命！』"]]}
      ]},
      {"portrait_id": 21, "source_dat": "FDTXT_030", "script": "ch30.json", "string_index": 3, "scene_index": 1, "line": 6, "count": 2, "native_utterances": [
        {"control_source": "fdtxt", "control": "FFEF", "operand": 126, "pages": [["『水與冰的女王，將這些傢伙", "　冰封在永恆的死之牢獄中！", "　』"]]},
        {"control_source": "fdtxt", "control": "FFEF", "operand": 123, "pages": [["『水魔神領命！』"]]}
      ]},
      {"portrait_id": 26, "source_dat": "FDTXT_030", "script": "ch30.json", "string_index": 4, "scene_index": 1, "line": 8, "count": 2, "native_utterances": [
        {"control_source": "fdtxt", "control": "FFEF", "operand": 126, "pages": [["『狂風的吟唱者，用你的利刃", "　將他們撕裂成血肉的飛霧！", "　』"]]},
        {"control_source": "fdtxt", "control": "FFEF", "operand": 124, "pages": [["『風魔神領命！』"]]}
      ]},
      {"portrait_id": 105, "source_dat": "FDTXT_030", "script": "ch30.json", "string_index": 5, "scene_index": 1, "line": 10, "count": 2, "native_utterances": [
        {"control_source": "fdtxt", "control": "FFEF", "operand": 126, "pages": [["『烈焰的主宰，燃起你的地獄", "　之火，把他們燒得連灰都不", "　剩！』"]]},
        {"control_source": "fdtxt", "control": "FFEF", "operand": 125, "pages": [["『火魔神領命！』"]]}
      ]},
      {"portrait_id": 32, "source_dat": "FDTXT_030", "script": "ch30.json", "string_index": 6, "scene_index": 1, "line": 12, "count": 1, "native_utterances": [
        {"control_source": "fdtxt", "control": "FFEF", "operand": 126, "pages": [["『遺憾得很，不識抬舉的你們", "　竟然選擇接受終末的天罰．", "　膽敢違抗神的意志的螻蟻們", "　迎接你們的最後一刻吧！』"]]}
      ]}
