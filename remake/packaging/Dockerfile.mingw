# Dockerfile.mingw — golang:1.22-bookworm + mingw-w64,供 CGO 跨編 Windows .exe(Ebiten 需要 CGO)。
# 建置一次快取成 image,避免每次 build-windows.sh 都重裝套件。
FROM golang:1.22-bookworm
RUN apt-get update -qq && apt-get install -y -qq \
    gcc-mingw-w64-x86-64 g++-mingw-w64-x86-64 file zip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# 建置映像時先抓好模組；正式封包命令可關閉網路，不臨時污染主機或下載相依套件。
COPY remake/go.mod remake/go.sum ./
RUN go mod download
